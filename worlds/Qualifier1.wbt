WorldInfo {
  info [
    "AI Grand Prix - Virtual Qualifier 1"
    "Start gate, nine intermediate gates, finish gate."
    "The Crazyflie runs the dcl_sim_bridge controller which emulates the"
    "competition simulator interface (MAVLink UDP + JPEG vision stream)."
  ]
  title "AI Grand Prix - Virtual Qualifier 1"
  basicTimeStep 8
  defaultDamping Damping {
    linear 0.5
    angular 0.5
  }
}
